# Runtime: .NET on Ubuntu Noble (PPA backports)
RUN apt-get install software-properties-common -y
RUN add-apt-repository ppa:dotnet/backports
APT_UPDATE
APT_INSTALL wget

REPEAT pkg IN {{packages}}
  DOWNLOAD {{pkg.url}} /tmp/{{pkg.name}}.deb
  RUN cd /tmp && apt install -y {{pkg.apt_name}}
  RUN cd /tmp && apt download -y {{pkg.apt_name}}
  RUN cd /tmp && ls && sha1sum {{pkg.name}}.deb
  RUN cd /tmp &&  echo {{pkg.hash}} {{pkg.name}}.deb >> hash_file.txt && cat hash_file.txt
  RUN cd /tmp && sha1sum -c hash_file.txt
END

RUN dotnet --version
APT_REMOVE wget
