# Runtime: .NET on Debian (Microsoft repo)
# Note: Uses SHA-1 for package verification because Microsoft .deb packages
# are distributed via apt, which uses SHA-1 in its package metadata.
APT_INSTALL wget
RUN cd /tmp && wget -q https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -O packages-microsoft-prod.deb
DPKG_INSTALL /tmp/packages-microsoft-prod.deb
RUN apt update -y

REPEAT pkg IN {{packages}}
  DOWNLOAD {{pkg.url}} /tmp/{{pkg.name}}.deb
  RUN cd /tmp && apt install -y --allow-downgrades {{pkg.apt_name}}
  RUN cd /tmp && apt download -y {{pkg.apt_name}}
  RUN cd /tmp && ls && sha1sum {{pkg.name}}.deb
  RUN cd /tmp &&  echo {{pkg.hash}} {{pkg.name}}.deb >> hash_file.txt && cat hash_file.txt
  RUN cd /tmp && sha1sum -c hash_file.txt
END

RUN dotnet --version
APT_REMOVE wget
