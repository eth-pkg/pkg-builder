# Runtime: Java (JDK only)
APT_INSTALL wget
RUN mkdir -p /opt/lib/jvm/jdk-{{jdk_version}}-oracle && mkdir -p /usr/lib/jvm
DOWNLOAD {{binary_url}} /tmp/jdk.tar.gz
RUN cd /tmp && echo "{{binary_checksum}} jdk.tar.gz" >>hash_file.txt && cat hash_file.txt
RUN cd /tmp && sha256sum -c hash_file.txt
RUN cd /tmp && tar -zxf jdk.tar.gz -C /opt/lib/jvm/jdk-{{jdk_version}}-oracle --strip-components=1
SYMLINK /opt/lib/jvm/jdk-{{jdk_version}}-oracle/bin/java /usr/bin/java
SYMLINK /opt/lib/jvm/jdk-{{jdk_version}}-oracle/bin/javac /usr/bin/javac
RUN java -version
APT_REMOVE wget
