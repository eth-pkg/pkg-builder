# === Preflight check ===
preflight:
	@if ! command -v $(DEBCRAFTER) >/dev/null 2>&1; then \
	  echo "Installing $(DEBCRAFTER)..."; \
	  cargo install --git https://github.com/Kixunil/debcrafter --rev $(DEBCRAFTER_REV) && cp $(HOME)/.cargo/bin/debcrafter $(HOME)/.cargo/bin/$(DEBCRAFTER); \
	fi
	@missing=""; \
	if ! command -v wget >/dev/null 2>&1; then missing="$$missing wget"; fi; \
	if ! command -v tar >/dev/null 2>&1; then missing="$$missing tar"; fi; \
	if ! command -v $(DEBCRAFTER) >/dev/null 2>&1; then missing="$$missing $(DEBCRAFTER)"; fi; \
	if ! command -v dpkg-parsechangelog >/dev/null 2>&1; then missing="$$missing dpkg-parsechangelog"; fi; \
	if ! command -v sbuild >/dev/null 2>&1; then missing="$$missing sbuild"; fi; \
	if [ -n "$$missing" ]; then \
	  echo "Error: missing required tool(s):$$missing"; \
	  exit 1; \
	fi; \
	echo "All required tools found."

# === Source ===
source: preflight
	mkdir -p $(OUT_DIR)
	cp $(SRC_URL) $(TARBALL_PATH)
	echo "$(SRC_HASH)  $(TARBALL_PATH)" | $(SRC_HASH_ALGO)sum -c

extract: source
	mkdir -p $(BUILD_FILES_DIR)
	tar -C $(BUILD_FILES_DIR) -xf $(TARBALL_PATH)

# === Debian packaging ===
debian: extract
	$(DEBCRAFTER) $(PKG_SPEC) $(OUT_DIR)

patch: debian
	mkdir -p $(SRC_DIR)/debian/source
	echo "3.0 (quilt)" > $(SRC_DIR)/debian/source/format
	mkdir -p $(SRC_DIR)/.pc && echo 2 > $(SRC_DIR)/.pc/version
	if [ -d $(ROOT)/src ]; then cp -r $(ROOT)/src/. $(SRC_DIR)/; fi
	chmod +x $(SRC_DIR)/debian/rules

# === Build ===
sbuild: patch
	sbuild \
	  -d $(DISTRIBUTION) \
	  -A -s --source-only-changes \
	  -c $(CHROOT_TARBALL) \
	  -v --chroot-mode=unshare \
	  --no-run-piuparts \
	  --no-apt-upgrade \
	  --no-apt-distupgrade \
	  --run-lintian \
	  --lintian-opt=-i --lintian-opt=--I \
	  --lintian-opt=--suppress-tags --lintian-opt=bad-distribution-in-changes-file \
	  --lintian-opt=--suppress-tags --lintian-opt=debug-file-with-no-debug-symbols \
	  --lintian-opt=--tag-display-limit=0 \
	  --lintian-opts=--fail-on=error --lintian-opts=--fail-on=warning \
	  --no-run-autopkgtest \
	  --build-dir=$(OUT_DIR) \
	  $(SRC_DIR)

# === Environment ===
env: preflight
	sbuild-createchroot --chroot-mode=unshare \
	  --make-sbuild-tarball $(CHROOT_TARBALL) \
	  $(DISTRIBUTION) /tmp/sbuild-createchroot $(REPO_URL)

build: sbuild

# === Test ===
test-lintian: build
	lintian $(OUT_DIR)/*.changes

test-piuparts: build
	sudo piuparts -d $(DISTRIBUTION) $(OUT_DIR)/*.deb

test-autopkgtest: build
	sudo autopkgtest $(OUT_DIR)/*.changes -- qemu $(CHROOT_DIR)/autopkgtest-$(DISTRIBUTION)-$(ARCH).img

test: test-lintian test-piuparts test-autopkgtest

# === Clean ===
clean:
	rm -rf $(OUT_DIR)
