# === Preflight check ===
preflight:
	@command -v $(DEBCRAFTER) >/dev/null 2>&1 || { \
	  if [ "$(INSTALL_DEPS)" = "1" ]; then \
	    echo 'Installing $(DEBCRAFTER)...'; \
	    cargo install --git https://github.com/Kixunil/debcrafter --rev $(DEBCRAFTER_REV) && cp $(HOME)/.cargo/bin/debcrafter $(HOME)/.cargo/bin/$(DEBCRAFTER); \
	  else \
	    echo 'Missing $(DEBCRAFTER). Install with:'; \
	    echo '  cargo install --git https://github.com/Kixunil/debcrafter --rev $(DEBCRAFTER_REV) && cp $(HOME)/.cargo/bin/debcrafter $(HOME)/.cargo/bin/$(DEBCRAFTER)'; \
	    exit 1; \
	  fi; \
	}
	@missing=''; \
	command -v tar >/dev/null 2>&1 || missing="$$missing tar"; \
	command -v $(DEBCRAFTER) >/dev/null 2>&1 || missing="$$missing $(DEBCRAFTER)"; \
	command -v dpkg-parsechangelog >/dev/null 2>&1 || missing="$$missing dpkg-parsechangelog"; \
	command -v sbuild >/dev/null 2>&1 || missing="$$missing sbuild"; \
	[ -z "$$missing" ] || { echo "Error: missing required tool(s):$$missing"; exit 1; }; \
	echo 'All required tools found.'

# === Directories ===
$(OUT_DIR):
	mkdir -p $@

# === Source ===
$(SRC_TARBALL): | $(OUT_DIR)
	mkdir -p $(SRC_DIR)
	tar czvf $@ --files-from /dev/null

# === Debian packaging ===
$(SRC_DIR)/debian/rules: $(SRC_TARBALL)
	mkdir -p $(SRC_DIR)
	tar -C $(SRC_DIR) -xf $(SRC_TARBALL)
	$(DEBCRAFTER) $(PKG_SPEC) $(OUT_DIR)

$(SRC_DIR)/debian/source/format: $(SRC_DIR)/debian/rules
	mkdir -p $(SRC_DIR)/debian/source
	echo "3.0 (quilt)" > $@
	mkdir -p $(SRC_DIR)/.pc && echo 2 > $(SRC_DIR)/.pc/version
	if [ -d $(ROOT)/src ]; then cp -r $(ROOT)/src/. $(SRC_DIR)/; fi
	chmod +x $(SRC_DIR)/debian/rules
	@cd $(SRC_DIR) && \
	  if ! grep -q '^Standards-Version:' debian/control; then \
	    awk -v hp='$(PKG_HOMEPAGE)' '\
	      /^Priority:/ && !done { print; print "Standards-Version: 4.5.1"; print "Homepage: " hp; done=1; next } \
	      { print }' debian/control > debian/control.tmp && \
	    mv debian/control.tmp debian/control; \
	  fi
	@cd $(SRC_DIR) && \
	  awk 'BEGIN{blank=0} /^$$/{blank++; if(blank==1) print; next} {blank=0; print}' debian/control > debian/control.tmp && \
	  mv debian/control.tmp debian/control

# === Build ===
SBUILD_FLAGS := \
	  -d $(DISTRIBUTION) \
	  -A -s --source-only-changes \
	  -c $(CHROOT_TARBALL) \
	  -v --chroot-mode=unshare \
	  --no-run-piuparts \
	  --no-apt-upgrade \
	  --no-apt-distupgrade
ifeq ($(RUN_LINTIAN),true)
SBUILD_FLAGS += \
	  --run-lintian \
	  --lintian-opt=-i --lintian-opt=--I \
	  --lintian-opt=--suppress-tags --lintian-opt=bad-distribution-in-changes-file \
	  --lintian-opt=--suppress-tags --lintian-opt=debug-file-with-no-debug-symbols \
	  --lintian-opt=--tag-display-limit=0 \
	  --lintian-opts=--fail-on=error --lintian-opts=--fail-on=warning
else
SBUILD_FLAGS += --no-run-lintian
endif
SBUILD_FLAGS += \
	  --no-run-autopkgtest \
	  --build-dir=$(OUT_DIR)

$(OUT_DIR)/.built: $(SRC_DIR)/debian/source/format $(CHROOT_TARBALL)
	sbuild $(SBUILD_FLAGS) \
