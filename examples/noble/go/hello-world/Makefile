	    exit 1; \
	  fi; \
	}
	@missing=''; \
	command -v wget >/dev/null 2>&1 || missing="$$missing wget"; \
	command -v tar >/dev/null 2>&1 || missing="$$missing tar"; \
	command -v $(DEBCRAFTER) >/dev/null 2>&1 || missing="$$missing $(DEBCRAFTER)"; \
